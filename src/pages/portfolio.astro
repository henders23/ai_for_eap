---
/**
 * Portfolio — the assembled document + PDF export. Reads across all stores via
 * the Portfolio island; @media print (in portfolio.css) flattens it for the PDF.
 */
import Base from '../layouts/Base.astro';
import Portfolio from '../components/Portfolio.tsx';
import '../styles/portfolio.css';
---

<Base
  title="Portfolio"
  description="Your assembled portfolio of kept work — exports to PDF, stays in your browser."
  maxWidth="none"
>
  <Portfolio client:load />
</Base>
