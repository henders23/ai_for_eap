---
/**
 * Library home — the "explore everything" hub.
 * Static/editorial; a tiny progressive-enhancement script reflects real
 * Module-0 progress (Done chip) from localStorage without shipping an island.
 */
import Base from '../layouts/Base.astro';
import { MODULES, moduleHref, TOOLKIT, EXEMPLARS } from '../lib/modules';
import '../styles/library.css';
---

<Base title="AI for EAP Practitioners" maxWidth="none">
  <div class="lib-main">
    <!-- HERO -->
    <section class="lib-hero">
      <span class="eyebrow">Open-access · Self-paced</span>
      <h1>Using AI in your teaching, thought through.</h1>
      <p class="lead">
        Nine short modules for EAP practitioners who are curious, cautious, or
        somewhere in between — light on the surface, serious underneath. Work
        through it in your own order, keep what you make, and leave with a
        portfolio.
      </p>
      <div class="cta-row">
        <a class="btn" href="/self-audit">Start with the 2-min self-audit →</a>
        <a class="browse-link" href="/modules">or browse the modules</a>
      </div>
    </section>

    <!-- ORIENTATION: the portfolio throughline -->
    <section class="orient" aria-label="How this resource works">
      <h2 class="sr-only">How this resource works</h2>
      <p class="orient-lead">
        One thread runs through everything: you keep what you make, and it becomes
        a portfolio you can export.
      </p>
      <ol class="orient-steps">
        <li>
          <span class="orient-num">1</span>
          <h3>Find your starting point</h3>
          <p>A two-minute self-audit sets a baseline “shape” of your confidence — one you’ll return to at the end.</p>
        </li>
        <li>
          <span class="orient-num">2</span>
          <h3>Work the modules</h3>
          <p>Nine short modules, in any order. Each ends in a small artefact or note, and you decide what to keep.</p>
        </li>
        <li>
          <span class="orient-num">3</span>
          <h3>Leave with a portfolio</h3>
          <p>What you keep gathers into one document — your shape, your artefacts, your framework coverage — that exports to PDF for accreditation, a manager, or yourself.</p>
        </li>
      </ol>
    </section>

    <!-- MODULES -->
    <section class="modules-section">
      <div class="sec-head sec-rule">
        <h2>The nine modules</h2>
        <span class="sec-aside">Any order is fine. Nothing is locked.</span>
      </div>
      <div class="modules-grid">
        {
          MODULES.map((m) => (
            <a class="module-card" href={moduleHref(m)} data-module={m.num}>
              <div class="module-card-top">
                <span class="module-num">{m.num}</span>
                {m.num === 'M0' && (
                  <span class="chip-done" data-done-chip style="display:none">
                    Done
                  </span>
                )}
              </div>
              <h3>{m.title}</h3>
              <p>{m.homeBlurb}</p>
              <div class="spacer" />
              <span class="card-cta">{m.cta} →</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- TOOLKIT -->
    <section class="toolkit-section" id="toolkit">
      <div class="toolkit-panel">
        <div class="sec-head">
          <h2>The toolkit</h2>
          <span class="sec-aside">Practical, honest, ready to adapt.</span>
        </div>
        <div class="toolkit-grid">
          {
            TOOLKIT.map((t) => (
              <a class="toolkit-card" href="/modules">
                <h3>{t.title}</h3>
                <p>{t.blurb}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- EXEMPLARS -->
    <section class="exemplars-section">
      <div class="sec-rule">
        <h2 style="margin:0;font-size:var(--fs-h2);letter-spacing:-0.015em;">
          From other practitioners
        </h2>
        <p class="intro">
          Peer-level examples from people at your stage — not polished expert
          models to measure yourself against.
        </p>
        <div class="exemplars-grid">
          {
            EXEMPLARS.map((e) => (
              <a class="exemplar-card" href="/modules">
                <h3>{e.title}</h3>
                <p>{e.blurb}</p>
                <div class="spacer" />
                <span class="by">{e.by}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="lib-footer">
      <p>
        Free and openly licensed (CC BY 4.0). No account, no tracking —
        everything you write stays in your own browser, and exports to PDF
        whenever you want it.
      </p>
      <span class="version">Module 0 · v0.1</span>
    </footer>
  </div>
</Base>

<script>
  // Progressive enhancement: reflect real Module-0 completion.
  import { auditCompleted } from '../lib/store';
  const card = document.querySelector('.module-card[data-module="M0"]');
  const chip = card?.querySelector('[data-done-chip]') as HTMLElement | null;
  if (chip) {
    chip.style.display = auditCompleted() ? '' : 'none';
  }
</script>
